<h1 style="color: black;">👨🏽 La tienda virtual de Roberto 🎮</h1>
<p style="font-size: 1.3em; color: #1e3a8a; margin-bottom: 25px;">🎉 ¡Descubre los mejores productos gamer! 🎮</p>

<div>
  <label for="filtro-categoria">Filtrar por categoría:</label>
  <select id="filtro-categoria" onchange="filtrarProductos()">
    <option value="todos">Todos</option>
    <option value="Consolas">Consolas</option>
    <option value="Mandos">Mandos</option>
    <option value="Accesorios">Accesorios</option>
    <option value="Juegos">Juegos</option>
    <option value="Independientes">Independientes</option>
  </select>
</div>

<div id="productos" class="contenedor-productos"></div>

<div class="carrito">
  <h2>🛒 Carrito de Compras</h2>
  <ul id="lista-carrito"></ul>
  <p><strong>Total: $<span id="total">0.00</span></strong></p>
  <button class="vaciar" onclick="vaciarCarrito()">☹️Vaciar Carrito</button>
  <button class="finalizar" onclick="finalizarCompra()">🥳 Finalizar Compra</button>
  <div id="paypal-button-container" style="margin-top: 20px;"></div>
</div>

<script src="https://www.paypal.com/sdk/js?client-id=sb&currency=COP"></script>
